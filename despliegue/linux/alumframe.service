[Unit]
Description=Aluframe (gestión del taller)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=alumframe
Group=alumframe
Environment=ALUMFRAME_CONFIG=/etc/alumframe/alumframe.toml
ExecStart=/opt/alumframe/alumframe
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/alumframe
# Discos de copias (carpeta AlumFrame-copias en su raíz); el «-» ignora las que no existan.
ReadWritePaths=-/mnt -/media -/run/media

[Install]
WantedBy=multi-user.target
